---
const locations = { coacalco: 'Coacalco', tultitlan: 'Tultitlán', tultepec: 'Tultepec', tlalnepantla: 'Tlalnepantla', 'ojo-de-agua': 'Ojo de Agua' };
export function getStaticPaths() { return ['coacalco','tultitlan','tultepec','tlalnepantla','ojo-de-agua'].map((slug) => ({ params: { slug } })); }
const { slug } = Astro.params; const city = locations[slug] || 'tu zona';
const wa = `https://wa.me/526722671419?text=${encodeURIComponent(`Hola, necesito una cotización de fumigación en ${city}.`)}`;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={`Control de plagas y fumigación en ${city}. Atención para casas y negocios con Fumigalia.`}/><title>Fumigación en {city} | Fumigalia</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.googleapis.com" crossorigin="anonymous"/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/></head><body><header class="nav"><a class="brand" href="/">Fumi<span>galia</span></a><a class="nav-link" href={wa}>WhatsApp: 672 267 1419</a></header><main><section class="hero"><p class="eyebrow">FUMIGACIÓN LOCAL</p><h1>Control de plagas en {city}.</h1><p class="lead">Atendemos casas y negocios con soluciones contra cucarachas, chinches, ratas, hormigas y otras plagas.</p><a class="button" href={wa}>Cotizar en {city} <span>↗</span></a></section><section class="section"><p class="eyebrow">SERVICIOS</p><h2>¿Qué problema tienes?</h2><div class="chips"><a href="/servicios/cucarachas">Cucarachas</a><a href="/servicios/chinches">Chinches</a><a href="/servicios/ratas-y-ratones">Ratas y ratones</a><a href="/servicios/hormigas">Hormigas</a><a href="/servicios/termitas">Termitas</a></div></section><section class="cta"><p class="eyebrow">ESTAMOS CERCA</p><h2>Explícanos qué está pasando.</h2><p>Te orientamos por WhatsApp y coordinamos el siguiente paso.</p><a class="button dark" href={wa}>Hablar con Fumigalia <span>↗</span></a></section></main><footer><span class="brand">Fumi<span>galia</span></span><span>Coacalco · Tultitlán · Tultepec · Tlalnepantla · Ojo de Agua</span><a href={wa}>672 267 1419</a></footer></body></html>
<style>
:global(*){box-sizing:border-box}:global(body){margin:0;background:#f8f8f2;color:#1A3C40;font-family:Inter,system-ui,sans-serif}:global(a){color:inherit;text-decoration:none}.nav{display:flex;justify-content:space-between;align-items:center;padding:27px 6vw}.brand{font-weight:800;font-size:1.55rem;letter-spacing:-.07em}.brand span{color:#7b8f50}.nav-link{font-size:.88rem;font-weight:600;border-bottom:1px solid #1A3C40}.hero{background:#1A3C40;color:#f8f8f2;padding:110px 10vw}.eyebrow{font-size:.72rem;letter-spacing:.13em;font-weight:700;color:#9bab71;margin:0 0 22px}.hero h1{font-size:clamp(3.2rem,7vw,7rem);line-height:.95;letter-spacing:-.085em;max-width:800px;margin:0}.lead{font-size:1.15rem;line-height:1.6;max-width:580px;color:#d4dfd7;margin:30px 0}.button{display:inline-flex;align-items:center;gap:30px;background:#FFF275;color:#1A3C40;border-radius:100px;padding:17px 22px 17px 26px;font-weight:800}.button span{font-size:1.25rem}.section{padding:105px 10vw}.section h2,.cta h2{font-size:clamp(2.5rem,5vw,5rem);line-height:.98;letter-spacing:-.08em;margin:0 0 35px}.chips{display:flex;flex-wrap:wrap;gap:12px}.chips a{border:1px solid #b8c6b2;border-radius:100px;padding:15px 21px;font-weight:600}.cta{margin:0 6vw 70px;background:#FFF275;padding:75px 8vw}.cta p:not(.eyebrow){color:#53695e}.dark{background:#1A3C40;color:#FFF275;margin-top:18px}footer{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding:35px 6vw;border-top:1px solid #dbe0d4;color:#61736d;font-size:.75rem}footer .brand{color:#1A3C40}footer a{font-weight:700;color:#1A3C40}@media(max-width:700px){.nav{padding:22px 6vw}.nav-link{font-size:.72rem}.hero{padding:75px 7vw}.hero h1{font-size:4rem}.section{padding:75px 7vw}.cta{margin:0 0 30px;padding:65px 7vw}}
</style>
