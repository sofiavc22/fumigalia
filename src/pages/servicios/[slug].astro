---
const data = {
  cucarachas: { title: 'Control de cucarachas', intro: 'Eliminamos cucarachas de tu casa o negocio con un tratamiento pensado para cortar el problema, no solo esconderlo.', signs: ['Cucarachas visibles de día o de noche', 'Excremento o manchas oscuras en esquinas', 'Mal olor en cocina, baños o coladeras'] },
  chinches: { title: 'Control de chinches', intro: 'Recupera la tranquilidad de tu habitación con una inspección y tratamiento completo contra chinches.', signs: ['Picaduras al despertar', 'Manchas de sangre en sábanas', 'Puntos oscuros en colchón o cabecera'] },
  'ratas-y-ratones': { title: 'Control de ratas y ratones', intro: 'Controlamos roedores y revisamos por dónde están entrando para ayudarte a evitar una nueva infestación.', signs: ['Ruidos en muros o plafones', 'Excremento cerca de comida', 'Cables o empaques mordidos'] },
  hormigas: { title: 'Control de hormigas', intro: 'Cortamos el camino de las hormigas y tratamos los puntos donde se están instalando.', signs: ['Filas de hormigas en cocina', 'Nidos en jardín o muros', 'Hormigas cerca de alimentos'] },
  termitas: { title: 'Control de termitas', intro: 'Detectamos señales de termitas y te orientamos sobre el tratamiento adecuado para proteger tu propiedad.', signs: ['Madera hueca o debilitada', 'Alas cerca de ventanas', 'Tubos de tierra en muros'] },
  mosquitos: { title: 'Control de mosquitos', intro: 'Reducimos la presencia de mosquitos en patios, jardines y espacios interiores.', signs: ['Mosquitos en patios o jardines', 'Agua estancada cerca de tu casa', 'Picaduras constantes'] },
};
export function getStaticPaths() { return ['cucarachas','chinches','ratas-y-ratones','hormigas','termitas','mosquitos'].map((slug) => ({ params: { slug } })); }
const { slug } = Astro.params;
const service = data[slug];
const wa = `https://wa.me/526722671419?text=${encodeURIComponent(`Hola, necesito ayuda con ${service?.title || 'una plaga'}.`)}`;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={`${service?.title} en Coacalco, Tultitlán, Tultepec, Tlalnepantla y Ojo de Agua. Cotiza por WhatsApp con Fumigalia.`}/><title>{service?.title} | Fumigalia</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/></head><body><header class="nav"><a class="brand" href="/">Fumi<span>galia</span></a><a class="nav-link" href={wa}>WhatsApp: 672 267 1419</a></header><main><section class="hero"><p class="eyebrow">FUMIGALIA · SERVICIO LOCAL</p><h1>{service?.title}</h1><p class="lead">{service?.intro}</p><a class="button" href={wa}>Cotizar por WhatsApp <span>↗</span></a></section><section class="content"><div><p class="eyebrow">SEÑALES COMUNES</p><h2>¿Has visto algo de esto?</h2><ul>{service?.signs.map((x) => <li>{x}</li>)}</ul></div><div class="panel"><p>Te orientamos sobre el siguiente paso</p><strong>Cuéntanos qué sucede en tu espacio.</strong><a href={wa}>Enviar mensaje →</a></div></section><section class="areas"><p class="eyebrow">COBERTURA</p><h2>Atendemos en tu zona.</h2><p>Coacalco, Tultitlán, Tultepec, Tlalnepantla y Ojo de Agua.</p><a class="text-link" href="/">Ver todos los servicios →</a></section></main><footer><span class="brand">Fumi<span>galia</span></span><span>Control de plagas local</span><a href={wa}>672 267 1419</a></footer></body></html>
<style>
:global(*){box-sizing:border-box}:global(body){margin:0;background:#f8f8f2;color:#1A3C40;font-family:Inter,system-ui,sans-serif}:global(a){color:inherit;text-decoration:none}.nav{display:flex;justify-content:space-between;align-items:center;padding:27px 6vw}.brand{font-weight:800;font-size:1.55rem;letter-spacing:-.07em}.brand span{color:#7b8f50}.nav-link{font-size:.88rem;font-weight:600;border-bottom:1px solid #1A3C40}.hero{background:#1A3C40;color:#f8f8f2;padding:110px 10vw}.eyebrow{font-size:.72rem;letter-spacing:.13em;font-weight:700;color:#9bab71;margin:0 0 22px}.hero h1{font-size:clamp(3.2rem,7vw,7rem);line-height:.95;letter-spacing:-.085em;max-width:800px;margin:0}.lead{font-size:1.15rem;line-height:1.6;max-width:580px;color:#d4dfd7;margin:30px 0}.button{display:inline-flex;align-items:center;gap:30px;background:#FFF275;color:#1A3C40;border-radius:100px;padding:17px 22px 17px 26px;font-weight:800}.button span{font-size:1.25rem}.content{padding:105px 10vw;display:grid;grid-template-columns:1fr 1fr;gap:8vw}.content h2,.areas h2{font-size:clamp(2.5rem,5vw,5rem);line-height:.98;letter-spacing:-.08em;margin:0 0 28px}.content ul{list-style:none;padding:0}.content li{padding:17px 0;border-top:1px solid #c4cfbe;font-weight:600}.content li:before{content:'✓';color:#899d5c;margin-right:13px}.panel{background:#FFF275;padding:35px;display:flex;flex-direction:column;justify-content:space-between;min-height:240px;transform:rotate(2deg)}.panel p{margin:0;font-size:.75rem;text-transform:uppercase;letter-spacing:.1em}.panel strong{font-size:2rem;line-height:1;letter-spacing:-.07em;max-width:300px}.panel a{font-weight:700}.areas{padding:90px 10vw;background:#e9eddf}.areas p:not(.eyebrow){color:#61736d;line-height:1.6}.text-link{font-weight:700;display:inline-block;margin-top:18px}footer{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding:35px 6vw;border-top:1px solid #dbe0d4;color:#61736d;font-size:.75rem}footer .brand{color:#1A3C40}footer a{font-weight:700;color:#1A3C40}@media(max-width:700px){.nav{padding:22px 6vw}.nav-link{font-size:.72rem}.hero{padding:75px 7vw}.hero h1{font-size:4rem}.content{padding:75px 7vw;display:block}.panel{margin-top:55px}.areas{padding:70px 7vw}}
</style>
